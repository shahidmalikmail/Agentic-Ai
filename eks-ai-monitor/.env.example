# Copy this file to .env and fill in real values.
# Never commit the real .env file - it is already in .gitignore.

# --- Temporal (runs locally on your laptop, never on the bastion) ---
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=eks-monitor-task-queue

# --- Monitoring cadence ---
MONITOR_INTERVAL_SECONDS=300
KUBECTL_TIMEOUT_SECONDS=30

# --- Bastion SSH (required) ---
BASTION_HOST=
BASTION_PORT=22
BASTION_USERNAME=
# Preferred: path to a private key file
BASTION_KEY_PATH=
# Only set BASTION_PASSWORD if you explicitly want password auth instead of a key.
# Leave empty when using BASTION_KEY_PATH.
BASTION_PASSWORD=
BASTION_CONNECT_TIMEOUT_SECONDS=15
BASTION_COMMAND_TIMEOUT_SECONDS=30

# --- LLM provider (Claude/Anthropic) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
