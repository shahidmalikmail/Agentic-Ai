# Copy this file to .env for local testing (never commit the real .env).
# Claude Desktop does not read .env - it supplies these same variables via
# the "env" block in claude_desktop_config.json.
#
# Multi-environment: this server can route each tool call to "dev" or "uat"
# via the tool's env parameter (default "dev"). Configure the environments
# you need below - an environment with no *_BASTION_* variables set is
# simply unavailable (calls to it return a clear error), it does not break
# the others.

# --- DEV ---
# If DEV_BASTION_* are not set, the legacy unprefixed BASTION_* variables
# below are used instead, so existing single-environment setups keep
# working unchanged.
DEV_BASTION_HOST=10.11.80.131
DEV_BASTION_PORT=22
DEV_BASTION_USER=ubuntu
# Must be an OpenSSH-format private key (Paramiko cannot reliably load raw
# PuTTY .ppk files). If you only have a .ppk, convert it first with
# PuTTYgen: Load the .ppk, then Conversions > Export OpenSSH key, and point
# this at the exported file. See README.md for the exact steps.
DEV_BASTION_KEY_PATH=C:\path\to\dev-bastion-openssh.key

# --- UAT ---
# UAT has no legacy fallback - all three UAT_BASTION_* variables are
# required together, or UAT stays unconfigured.
UAT_BASTION_HOST=10.12.80.197
UAT_BASTION_PORT=22
UAT_BASTION_USER=ubuntu
UAT_BASTION_KEY_PATH=C:\path\to\uat-bastion-openssh.key

# --- Legacy (used as DEV fallback only if DEV_BASTION_* above are unset) ---
BASTION_HOST=10.11.80.131
BASTION_PORT=22
BASTION_USER=ubuntu
#BASTION_KEY_PATH=C:\path\to\ob-dev-bastion-9-1-11-0-openssh.key
#BASTION_KEY_PATH=D:\Solveda-Data-OnDrive-10-oct-25\OneDrive - SAKSOFT LIMITED\Office Brands Project\OB-AWS-Pem-Key\ob-aws-key-for-9-1-11-0\ob-dev-bastion-9-1-11-0.ppk
BASTION_KEY_PATH=D:\Solveda-Data-OnDrive-10-oct-25\OneDrive - SAKSOFT LIMITED\Office Brands Project\OB-AWS-Pem-Key\ob-aws-key-for-9-1-11-0\ob-dev-bastion-9-1-11-0.pem

# --- Common (shared by every environment) ---
# Linux user on the bastion that already has kubectl/AWS/EKS access configured.
KUBERNETES_USER=solveda

SSH_TIMEOUT=15
COMMAND_TIMEOUT=30
