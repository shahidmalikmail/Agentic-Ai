# Template for eks-prod-readonly's environment variables ONLY.
#
# This is a SEPARATE server/process from eks-readonly and eks-commerce.
# These variables are read exclusively by prod_config.py. Neither
# config.py nor kube_core.py ever reads PROD_BASTION_* - eks-readonly and
# eks-commerce never see these values, and this server never sees
# DEV_BASTION_*/UAT_BASTION_*/unprefixed BASTION_* values.
#
# There is NO legacy/unprefixed BASTION_* fallback for PROD (unlike DEV in
# the main .env.example) and NO partial configuration: all of
# PROD_BASTION_HOST, PROD_BASTION_USER, PROD_BASTION_KEY_PATH, and
# KUBERNETES_USER are required together, or the server refuses to start.
#
# Copy the values you need into eks-prod-readonly's own "env" block in
# Claude Desktop's mcpServers config - do NOT add them to the existing
# eks-readonly/eks-commerce "env" blocks or to the shared .env file.

PROD_BASTION_HOST=10.13.96.105
PROD_BASTION_PORT=22
PROD_BASTION_USER=ubuntu
# Must be an OpenSSH-format private key (Paramiko cannot reliably load raw
# PuTTY .ppk files). If you only have a .ppk, convert it first with
# PuTTYgen: Load the .ppk, then Conversions > Export OpenSSH key, and point
# this at the exported file. See README.md's "About the SSH key" section
# for the exact steps (the same guidance applies to PROD).
PROD_BASTION_KEY_PATH=C:\path\to\prod-bastion-openssh.key

# --- Common ---
# Linux user on the PROD bastion that already has kubectl/AWS/EKS access
# configured. Read from the same variable name as DEV/UAT, but this process
# never reads DEV_BASTION_*/UAT_BASTION_*, so there is no cross-environment
# leakage even though the variable name is shared.
KUBERNETES_USER=solveda

SSH_TIMEOUT=15
COMMAND_TIMEOUT=30
