{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TemporaryStartQueryAllLogGroupsUnverifiedScoping",
      "Effect": "Allow",
      "Action": "logs:StartQuery",
      "Resource": "*"
    },
    {
      "Sid": "TemporaryPollAndStopQueriesUnverifiedScoping",
      "Effect": "Allow",
      "Action": [
        "logs:GetQueryResults",
        "logs:StopQuery"
      ],
      "Resource": "*"
    }
  ]
}
