# aws-cloudwatch-mcp configuration (local Windows laptop). Copy to .env (never commit .env).
#
# NO CREDENTIALS BELONG HERE. Authentication uses the AWS CLI profile below, which boto3
# resolves through the standard credential chain (configured once with:
#   aws configure --profile ob-aws-cloudwatch
# ). Do not add access keys, secret keys or session tokens to this file.
#
# Claude Desktop passes these three values in its "env" block, so a .env file is optional.
# To load a .env from another location, set AWS_CW_MCP_ENV_FILE=<path> in the environment.

# --- AWS (required) ------------------------------------------------------
AWS_PROFILE=ob-aws-cloudwatch
AWS_REGION=us-east-1
# The server refuses to run any AWS operation unless sts:GetCallerIdentity returns this account.
AWS_ACCOUNT_ID=926266574832

# --- Log group scope -----------------------------------------------------
# Comma-separated glob patterns. Empty = allow every log group the IAM user can see.
# LOG_GROUP_ALLOWLIST=/aws/eks/*,/aws/waf/*,/aws/lambda/*

# --- Limits / cost controls ----------------------------------------------
DEFAULT_LOOKBACK_MINUTES=60
MAX_LOG_RESULTS=200
MAX_QUERY_RESULTS=1000

MAX_LOG_TIME_RANGE_HOURS=24
MAX_METRIC_TIME_RANGE_HOURS=720
# MAX_LOG_GROUPS_PER_QUERY=5
# MAX_METRIC_QUERIES=10
# MAX_PAGES=10
# MAX_DATAPOINTS_RETURNED=200
# MAX_MESSAGE_CHARS=800
# MAX_RESPONSE_CHARS=60000
# CACHE_TTL_SECONDS=60
# AWS_API_CONNECT_TIMEOUT=5
# AWS_API_READ_TIMEOUT=30
# AWS_API_MAX_ATTEMPTS=5
# LOG_LEVEL=INFO

# --- Phase 2A: CloudWatch Logs Insights (OFF by default; leave commented to keep Phase 1 only) -------
# Requires the dedicated Insights identity/profile (see docs/PHASE-2A-IAM-APPLY-GUIDE.md). Never put keys here.
# INSIGHTS_ENABLED=true
# AWS_INSIGHTS_PROFILE=ob-aws-cloudwatch-insights
# AWS_INSIGHTS_REGION=us-east-1                     # Insights region (PROD log groups are in us-east-1); unset = same as AWS_REGION
# AWS_INSIGHTS_EXPECTED_ARN=arn:aws:iam::926266574832:user/cloud-watch-insights-review
# INSIGHTS_MAX_RANGE_HOURS=24
# INSIGHTS_MAX_LOG_GROUPS=5
# INSIGHTS_MAX_RESULT_ROWS=200
# INSIGHTS_MAX_ESTIMATED_BYTES=2147483648        # per query (2 GiB)
# INSIGHTS_SESSION_BYTES_BUDGET=21474836480      # per server process (20 GiB)
# INSIGHTS_MAX_CONCURRENT=2
# INSIGHTS_MAX_STARTS_PER_MINUTE=6
# INSIGHTS_WAIT_SECONDS=40                       # before a continuation handle is returned
# INSIGHTS_MAX_QUERY_SECONDS=180                 # application deadline, then StopQuery
# INSIGHTS_MAX_QUERY_CHARS=2000
# INSIGHTS_MAX_STAGES=6
# INSIGHTS_CACHE_TTL_SECONDS=120
# INSIGHTS_PRICE_PER_GB_USD=                     # optional; confirm the current price yourself
