# aws-cloudwatch-mcp configuration (local Windows laptop). Copy to .env (never commit .env).
#
# NO CREDENTIALS BELONG HERE. Authentication uses the AWS CLI profile below, which boto3
# resolves through the standard credential chain (configured once with:
#   aws configure --profile ob-aws-cloudwatch
# ). Do not add access keys, secret keys or session tokens to this file.
#
# Claude Desktop passes these three values in its "env" block, so a .env file is optional.
# To load a .env from another location, set AWS_CW_MCP_ENV_FILE=<path> in the environment.

# --- AWS (required) ------------------------------------------------------
AWS_PROFILE=ob-aws-cloudwatch
AWS_REGION=us-east-1
# The server refuses to run any AWS operation unless sts:GetCallerIdentity returns this account.
AWS_ACCOUNT_ID=926266574832

# --- Log group scope -----------------------------------------------------
# Comma-separated glob patterns. Empty = allow every log group the IAM user can see.
# LOG_GROUP_ALLOWLIST=/aws/eks/*,/aws/waf/*,/aws/lambda/*

# --- Limits / cost controls ----------------------------------------------
DEFAULT_LOOKBACK_MINUTES=60
MAX_LOG_RESULTS=200
MAX_QUERY_RESULTS=1000
# MAX_LOG_TIME_RANGE_HOURS=24
# MAX_METRIC_TIME_RANGE_HOURS=720
# MAX_LOG_GROUPS_PER_QUERY=5
# MAX_METRIC_QUERIES=10
# MAX_PAGES=10
# MAX_DATAPOINTS_RETURNED=200
# MAX_MESSAGE_CHARS=800
# MAX_RESPONSE_CHARS=60000
# CACHE_TTL_SECONDS=60
# AWS_API_CONNECT_TIMEOUT=5
# AWS_API_READ_TIMEOUT=30
# AWS_API_MAX_ATTEMPTS=5
# LOG_LEVEL=INFO
